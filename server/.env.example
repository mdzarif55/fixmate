PORT=5000
NODE_ENV=development

# MongoDB Atlas or local MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fixmate?retryWrites=true&w=majority

# Auth & JWT
JWT_SECRET=replace-with-secure-64-char-random-secret
BETTER_AUTH_SECRET=replace-with-secure-64-char-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Frontend URL for CORS & Stripe Redirects
CLIENT_URL=http://localhost:3000

# ImgBB Image Upload
IMGBB_API_KEY=your-imgbb-api-key

# Stripe (Test Mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Optional Google Social Login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
